# Microservices (source of truth for image/tag override)
KE_AUTO_BILLING_IMAGE=europe-west4-docker.pkg.dev/kikker/repository/ke-auto-billing
KE_AUTO_BILLING_TAG=0.0.221

FINALBILLCALCULATOR_IMAGE=europe-west4-docker.pkg.dev/kikker/repository/finalbillcalculator
FINALBILLCALCULATOR_TAG=0.0.906

KE_BILLING_GENERATOR_IMAGE=europe-west4-docker.pkg.dev/kikker/repository/ke-billing-generator
KE_BILLING_GENERATOR_TAG=0.0.385

KE_HOURLY_PRODUCT_IMAGE=europe-west4-docker.pkg.dev/kikker/repository/ke-hourly-product
KE_HOURLY_PRODUCT_TAG=0.0.449

KE_CORE_IMAGE=europe-west4-docker.pkg.dev/kikker/kikker/ke-core
KE_CORE_TAG=0.1.43

KE_PRICING_IMAGE=europe-west4-docker.pkg.dev/kikker/kikker-charts/ke-pricing
KE_PRICING_TAG=0.0.1358

KE_EDSN_REST_API_POC_IMAGE=europe-west4-docker.pkg.dev/kikker/repository/ke-edsn-rest-api-poc
KE_EDSN_REST_API_POC_TAG=0.0.109

KE_P4_EAN_USAGE_IMAGE=europe-west4-docker.pkg.dev/kikker/kikker/ke-p4-ean-usage
KE_P4_EAN_USAGE_TAG=0.0.231

KE_PDF_IMAGE=europe-west4-docker.pkg.dev/kikker/repository/ke-pdf
KE_PDF_TAG=0.0.51

KE_CALCULATED_LEGACY_IMAGE=europe-west4-docker.pkg.dev/kikker/cloud-run-source-deploy/ke-calculated-meter-readings/profile-calculated-meter-reads@sha256
KE_CALCULATED_LEGACY_TAG=240b546bc94c80f4c12ba9fe157d10de9685ffb42282ae64f8c916df34f89848

KE_CALCULATED_DYNAMIC_IMAGE=europe-west4-docker.pkg.dev/kikker/cloud-run-source-deploy/ke-calculated-meter-readings/dynamic-fractions@sha256
KE_CALCULATED_DYNAMIC_TAG=ffed3f1022022fa43767a6af9ccf3af78d370a03f91e10ec2b1d691af9f1c186

# Optional baseline API in current compose
BILLING_API_IMAGE=europe-west4-docker.pkg.dev/kikker/kikker/billing-api
BILLING_API_TAG=0.1.43

# Test runner container (used when running compose profile "itest")
ITEST_RUNNER_IMAGE=europe-west4-docker.pkg.dev/kikker/kikker/itest-runner
ITEST_RUNNER_TAG=0.1.0

# Infrastructure defaults for local integration environment
POSTGRES_IMAGE=postgres
POSTGRES_TAG=16-alpine
POSTGRES_DB=kikker_billing
POSTGRES_USER=kikker
POSTGRES_PASSWORD=kikker

MYSQL_IMAGE=mysql
MYSQL_TAG=8.0
MYSQL_DATABASE=kikkercore
MYSQL_USER=kikker
MYSQL_PASSWORD=kikker
MYSQL_ROOT_PASSWORD=kikker
MYSQL_INIT_LOAD_KIKKER_HOURLY_SCHEMA=false

RABBITMQ_IMAGE=rabbitmq
RABBITMQ_TAG=3.13-management
RABBITMQ_DEFAULT_USER=kikrmq
RABBITMQ_DEFAULT_PASS=kikker

# GCP defaults for services using Google Cloud logging sink
GCP_PROJECT_ID=kikker
